{
  "manifest_version": 3,
  "name": "豆瓣+图书馆查询助手",
  "permissions": ["storage", "contextMenus"],
  "version": "1.4.0",
  "minimum_chrome_version": "109",
  "host_permissions": ["https://navy82.icu/*"],

  "action": {
    "default_icon": "img/book_128.png",
    "default_popup": "popup.html",
    "default_title": "豆瓣+图书馆查询助手"
  },

  "content_scripts": [
    {
      "css": ["result-ui.css"],
      "js": ["provinces.js", "extension-utils.js", "result-ui.js", "content.js"],
      "matches": ["https://book.douban.com/subject/*"]
    }
  ],
  "description": "自动查询指定图书馆图书信息，让用户更轻松地找到所需的图书馆资源。",
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "128": "img/book_128.png",
    "16": "img/book_16.png",
    "32": "img/book_32.png"
  },
  "homepage_url": "https://navy82.icu/",
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  }
}
